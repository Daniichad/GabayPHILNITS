{
  "expo": {
    "name": "Gabay PhilCSE",
    "slug": "gabay_philcse",
    "scheme": "gabay-philcse",
    "version": "1.0.0",
    "updates": {
      "enabled": false
    },
    "orientation": "portrait",
    "icon": "./assets/app_logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo_text_dark.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f7fb"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app_logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.gabay_philcse"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/app_logo.png",
          "color": "#0f2747"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b5909ad9-e928-4b90-aeeb-af2966fb4339"
      }
    }
  }
}
